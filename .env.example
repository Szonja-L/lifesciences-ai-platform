# Copy to .env for local use. .env is git-ignored; never commit real values.
# Every variable below maps to a field in src/lifesciences_platform/common/config.py.

# Runtime environment: dev | test | prod  (default: dev)
APP_ENV=dev

# Logging verbosity: DEBUG | INFO | WARNING | ERROR | CRITICAL  (default: INFO)
LOG_LEVEL=INFO

# ---- PostgreSQL (docker-compose.yml reads these four) ----
# Local development only; the port is bound to 127.0.0.1. Pick your own password.
POSTGRES_USER=lsp
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=lifesciences
POSTGRES_PORT=5432

# Connection string used by the app, Alembic and the DB tests. Must use the psycopg 3
# driver prefix postgresql+psycopg:// and repeat the values above.
DATABASE_URL=postgresql+psycopg://lsp:change-me-local-only@127.0.0.1:5432/lifesciences

# ---- Uploads ----
# Largest accepted file in bytes. Empty = 5242880 (5 MB).
MAX_UPLOAD_BYTES=
# Where uploaded files are stored: an absolute path, or one starting with ~.
# Empty = ~/.lifesciences-platform/uploads (outside the repository).
UPLOAD_DIR=

# ---- Validation ----
# Most data rows a manifest may have. Empty = 1000.
MAX_MANIFEST_ROWS=

# Tests: 1 = fail (instead of skip) when the database is unreachable. CI sets 1.
REQUIRE_DB=

# Anthropic API key. Unused until the LLMClient task; leave empty for now.
ANTHROPIC_API_KEY=

# Monthly LLM spend cap in euros (a number >= 0). Empty = not configured.
# Enforced by the LLMClient once it exists.
LLM_MONTHLY_BUDGET_EUR=
