# Copy to .env for local use. .env is git-ignored; never commit real values.
# Every variable below maps to a field in src/lifesciences_platform/common/config.py.

# Runtime environment: dev | test | prod  (default: dev)
APP_ENV=dev

# Logging verbosity: DEBUG | INFO | WARNING | ERROR | CRITICAL  (default: INFO)
LOG_LEVEL=INFO

# Database connection string. Unused until the storage task; leave empty for now.
# Example shape only: postgresql://user:password@localhost:5432/dbname
DATABASE_URL=

# Anthropic API key. Unused until the LLMClient task; leave empty for now.
ANTHROPIC_API_KEY=

# Monthly LLM spend cap in euros (a number >= 0). Empty = not configured.
# Enforced by the LLMClient once it exists.
LLM_MONTHLY_BUDGET_EUR=
